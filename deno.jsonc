{
  "deno": {
    "unstable": true
  },
  "version": "0.0.1",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "esnext",
      "deno.window",
      "deno.unstable",
      "deno.ns"
    ],
    "types": [
      "npm:@types/webscreens-window-placement",
      "./src/frontend/scripts/globals.d.ts"
    ]
  },
  "exclude": [
    "src/backend/dist"
  ],
  "include": [
    "src/frontend/scripts"
  ],
  "tasks": {
    // Go now serves the frontend directly (go:embed of src/backend/dist), so
    // "dev" just keeps the bundle fresh and runs the Go server; there's no
    // separate Deno file-server anymore.
    "dev": "deno task clean; deno task bundle-watch & (cd src/backend && go run .)",
    "build": "deno task bundle",
    "check": "deno check src/frontend/scripts",
    "clean": "rm -rf src/backend/dist/*",
    "bundle": "deno bundle src/frontend/index.html src/frontend/html/pop.html --code-splitting --platform browser --sourcemap --outdir src/backend/dist",
    "bundle-script": "deno task --unstable-bundle bundle.ts",
    "bundle-watch": "deno bundle --watch src/frontend/index.html src/frontend/html/pop.html --code-splitting --platform browser --sourcemap --outdir src/backend/dist"
  },
  "permissions": {
    "net-read": {
      "net": true,
      "read": true
    }
  },
  "imports": {
    "@awesome.me/webawesome": "npm:@awesome.me/webawesome@^3.12.0",
    "@types/webscreens-window-placement": "npm:@types/webscreens-window-placement@^0.1.3",
    "wordgard": "npm:wordgard@latest"
  }
}
