{
  "deno": {
    "unstable": true
  },
  "version": "0.0.1",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "esnext",
      "deno.window",
      "deno.unstable",
      "deno.ns"
    ],
    "types": [
      "npm:@types/webscreens-window-placement",
      "./src/frontend/scripts/globals.d.ts"
    ]
  },
  "exclude": [
    "dist"
  ],
  "include": [
    "src/frontend/scripts",
    "src/backend"
  ],
  "tasks": {
    "dev": "deno task clean; deno task bundle-watch & deno task start",
    "build": "deno task bundle",
    "start": "deno run --allow-net --allow-read -ESR jsr:@std/http/file-server dist",
    "clean": "rm -r dist/*",
    "bundle": "deno bundle src/frontend/index.html src/frontend/html/pop.html --code-splitting --platform browser --sourcemap --outdir dist",
    "bundle-script": "deno task --unstable-bundle bundle.ts",
    "bundle-watch": "deno bundle --watch src/frontend/index.html src/frontend/html/pop.html --code-splitting --platform browser --sourcemap --outdir dist"
  },
  "permissions": {
    "net-read": {
      "net": true,
      "read": true
    }
  },
  "imports": {
    "@awesome.me/webawesome": "npm:@awesome.me/webawesome@^3.12.0",
    "@hono/hono": "jsr:@hono/hono@^4.13.3",
    "@types/webscreens-window-placement": "npm:@types/webscreens-window-placement@^0.1.3",
    "wordgard": "npm:wordgard@latest"
  }
}
