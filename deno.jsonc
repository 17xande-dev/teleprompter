{
  "deno": {
    "unstable": true
  },
  "version": "0.0.1",
  // deno fmt's HTML support de-dents slotted children below their parent
  // element, which makes index.html markedly harder to read than the hand
  // formatting — and it rewrites the icon asset to no purpose. Excluded here
  // rather than remembered, so a bare `deno fmt` over the repo stays safe.
  "fmt": {
    // deno fmt formats markdown too, and it re-aligns the tables in
    // docs/shortcuts.md — which is generated. Formatted, the file on disk no
    // longer matches what tools/gen-docs.ts produces, and docs_test.ts fails
    // on a file that was freshly generated. The generator pads its own
    // columns, so nothing is lost by leaving it alone.
    "exclude": ["**/*.html", "**/*.svg", "docs/shortcuts.md"]
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "esnext",
      "deno.window",
      "deno.unstable",
      "deno.ns"
    ],
    "types": [
      "npm:@types/webscreens-window-placement",
      "./src/frontend/scripts/globals.d.ts"
    ]
  },
  "exclude": [
    "src/backend/dist"
  ],
  "include": [
    "src/frontend/scripts"
  ],
  "tasks": {
    // Go serves the frontend directly (go:embed of src/backend/dist), so
    // "dev" just keeps the bundle fresh and runs the Go server; there's no
    // separate Deno file-server anymore. -dev makes the server read dist/
    // off disk, since the embedded copy is fixed at compile time and would
    // otherwise ignore everything bundle-watch rebuilds.
    // air rebuilds and restarts the Go server when a .go file changes (see
    // src/backend/.air.toml); it replaces `go run`, which had to be killed and
    // re-run by hand. The frontend half is unchanged: bundle-watch rewrites
    // dist/ and -dev makes the server read it off disk.
    "dev": "deno task clean && (deno task bundle-watch & (cd src/backend && air))",
    // Cleans first, deliberately. `deno bundle` content-hashes its output
    // names, so every rebuild writes a new index-<hash>.js plus its sourcemap
    // (~3.6MB — it inlines the whole dependency graph) and leaves every
    // previous one behind. Nothing serves them — index.html names exactly one
    // — but go:embed takes the whole directory, so they all end up in the
    // binary. Left alone over a session's worth of rebuilds this had grown
    // dist/ to 232MB, of which 223MB was stale output, and the binary with it.
    "build": "deno task clean && deno task bundle",
    "check": "deno check src/frontend/scripts",
    // --no-check: `deno task check` already covers types; without it, `deno
    // test`'s type-check pass pulls in the whole configured project graph
    // (including teleprompter.ts's raw CSS imports, which only the bundler
    // knows how to resolve) even for a test file that doesn't import it.
    "test": "deno test --no-check --allow-read=. src/frontend/scripts/*_test.ts",
    // The glob skips dotfiles, so dist/.gitkeep — tracked so a fresh checkout
    // has something for go:embed to find — survives this.
    "clean": "rm -rf src/backend/dist/*",
    "bundle": "deno task bundle-app && deno task bundle-pdfjs && deno task bundle-pdfworker && deno task copy-pdfjs-assets && deno task copy-icons",
    "bundle-app": "deno bundle src/frontend/index.html src/frontend/html/viewer.html --code-splitting --platform browser --sourcemap=linked --outdir src/backend/dist",
    // Both pdf.js entries are loaded by URL at runtime — the library by
    // pdfview.ts, the worker by pdf.js itself — so both need a URL we can
    // write down. Bundled with the app entries they'd get content hashes
    // (--code-splitting hashes .ts entries too), hence their own standalone
    // invocations, which emit plain "pdfjs.js" and "pdfworker.js".
    "bundle-pdfjs": "deno bundle src/frontend/scripts/pdfjs.ts --platform browser --outdir src/backend/dist",
    "bundle-pdfworker": "deno bundle src/frontend/scripts/pdfworker.ts --platform browser --outdir src/backend/dist",
    // The bundler emits JS and CSS only; pdf.js's font and wasm side-files
    // have to be copied in separately.
    "copy-pdfjs-assets": "deno run --allow-read --allow-write tools/copy-pdfjs-assets.ts",
    // Same reason: the bundler emits no static assets, so index.html's favicon
    // was a 404 on every page load until this ran.
    // docs/shortcuts.md is generated from the command table rather than
    // written, because that table already feeds the palette, the in-app
    // cheatsheet and the key bindings — a hand-kept doc would be a fourth
    // copy and the only one nothing checks. docs_test.ts fails when it is
    // stale, so this is not a step anyone has to remember.
    "docs": "deno run --allow-read=. --allow-write=docs tools/gen-docs.ts",
    "copy-icons": "deno run --allow-read --allow-write tools/copy-icons.ts",
    "bundle-script": "deno task --unstable-bundle bundle.ts",
    "bundle-watch": "deno task bundle-pdfjs && deno task bundle-pdfworker && deno task copy-pdfjs-assets && deno bundle --watch src/frontend/index.html src/frontend/html/viewer.html --code-splitting --platform browser --sourcemap=linked --outdir src/backend/dist"
  },
  "permissions": {
    "net-read": {
      "net": true,
      "read": true
    }
  },
  "imports": {
    // Declared here rather than imported as a bare "jsr:@std/assert" in each
    // test file, which is what no-import-prefix and no-unversioned-import were
    // both complaining about — 16 problems, two per test file, and one more
    // pair every time a test file was added.
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@awesome.me/webawesome": "npm:@awesome.me/webawesome@^3.12.0",
    // CodeMirror backs the viewer-theme CSS editor (cssEditor.ts). Reached
    // only from the control-page module graph — the two HTML entries bundle
    // separately, so a stray import from viewer.ts would make every viewer
    // download an editor it never opens.
    "codemirror": "npm:codemirror@^6.0.2",
    "@codemirror/lang-css": "npm:@codemirror/lang-css@^6.3.1",
    "@codemirror/state": "npm:@codemirror/state@^6.7.4",
    "@codemirror/view": "npm:@codemirror/view@^6.43.11",
    "@codemirror/theme-one-dark": "npm:@codemirror/theme-one-dark@^6.1.3",
    "@types/webscreens-window-placement": "npm:@types/webscreens-window-placement@^0.1.3",
    "pdfjs-dist": "npm:pdfjs-dist@^6.3.289",
    // Key bindings for the control page (paletteControls.ts). Control-page
    // graph only, for the same reason as CodeMirror above — and it is eval
    // free, which the page's script-src requires.
    "tinykeys": "npm:tinykeys@^3.1.0",
    "wordgard": "npm:wordgard@latest"
  }
}
